# atlas_prime —— 普通 Linux 部署 unit（拷入 /etc/systemd/system/ 后：
#   systemctl daemon-reload && systemctl enable --now atlas-prime）
# Type=simple：ExecStart 即前台进程（守护现状契约）；停止走默认 KillSignal=SIGTERM，
# 超时 TimeoutStopSec（默认 90s）后 systemd 兜底 SIGKILL；stdout/stderr 自动进 journald。
[Unit]
Description=atlas_prime system monitor daemon
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/atlas_prime
Environment=ATLAS_BIND=0.0.0.0:1025
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
